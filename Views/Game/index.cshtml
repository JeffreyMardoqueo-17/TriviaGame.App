@{
    ViewData["Title"] = "Juego de Trivia";
    var gameSessionId = Context.Request.Query["gameSessionId"].ToString();
}

<h2>Juego de Trivia</h2>

<div id="game-container">
    <div id="question-section">
        <h4 id="question-text"></h4>

        <ul id="answers-list" class="list-group mb-3"></ul>

        <p id="timer">
            Tiempo restante: <span id="time-left">0</span> segundos
        </p>
    </div>

    <div id="game-message" style="display:none;" class="alert alert-info"></div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>
        const gameSessionId = parseInt('@gameSessionId');
        const token = '@Context.Session.GetString("JWT")';

        let connection = null;
        let currentQuestion = null;
        let timer = null;
        let timeLeft = 0;

        document.addEventListener("DOMContentLoaded", startGame);

        async function startGame() {
            console.log("Iniciando juego. Session:", gameSessionId);

            connection = new signalR.HubConnectionBuilder()
                .withUrl("https://localhost:7235/gamehub", {
                    accessTokenFactory: () => token
                })
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveQuestion", question => {
                console.log("Pregunta recibida:", question);
                renderQuestion(question);
            });

            connection.on("GameEnded", () => {
                clearInterval(timer);
                document.getElementById("question-section").style.display = "none";
                document.getElementById("game-message").textContent = "Juego terminado";
                document.getElementById("game-message").style.display = "block";
            });

            await connection.start();
            await connection.invoke("StartGame", gameSessionId);
        }

       function renderQuestion(question) {
    console.log("Renderizando:", question);

    currentQuestion = question;
    timeLeft = question.timeLimitSeconds || 30;

    document.getElementById("question-text").textContent =
        question.questionText;

    const list = document.getElementById("answers-list");
    list.innerHTML = "";

    question.answers.forEach(a => {
        const li = document.createElement("li");
        li.textContent = a.text;
        li.className = "list-group-item list-group-item-action";
        li.style.cursor = "pointer";
        li.onclick = () => submitAnswer(a.id);
        list.appendChild(li);
    });

    startTimer();
}


        function startTimer() {
            clearInterval(timer);
            document.getElementById("time-left").textContent = timeLeft;

            timer = setInterval(() => {
                timeLeft--;
                document.getElementById("time-left").textContent = timeLeft;

                if (timeLeft <= 0) {
                    clearInterval(timer);
                    submitAnswer(0);
                }
            }, 1000);
        }

        async function submitAnswer(answerId) {
    clearInterval(timer);

    await connection.invoke(
        "SubmitAnswer",
        gameSessionId,
        currentQuestion.questionId,
        answerId,
        (currentQuestion.timeLimitSeconds || 30) - timeLeft
    );
}
    </script>
}
