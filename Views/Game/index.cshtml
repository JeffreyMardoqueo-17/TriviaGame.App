@{
    ViewData["Title"] = "Juego de Trivia";
    var jwtToken = Context.Session.GetString("JWT");
    var gameSessionId = (int)ViewBag.GameSessionId;
}

<h2 class="text-center my-4">Juego de Trivia</h2>

<div class="container">
    <div class="card shadow p-4">
        <h4 id="question-text"></h4>
        <ul id="answers-list" class="list-group mb-3"></ul>
        <p class="text-end">⏱ Tiempo: <span id="time">0</span>s</p>
        <div id="result" class="alert alert-info d-none"></div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    const token = '@jwtToken';
    const gameSessionId = @gameSessionId;

    let startTime = 0;

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("https://localhost:7235/gamehub?access_token=" + token)
        .withAutomaticReconnect()
        .build();

    async function start() {
        await connection.start();
        loadNextQuestion();
    }

    async function loadNextQuestion() {
        const question = await connection.invoke("GetNextQuestion", gameSessionId);

        if (!question) {
            endGame();
            return;
        }

        startTime = Date.now();

        document.getElementById("question-text").innerText = question.questionText;
        const list = document.getElementById("answers-list");
        list.innerHTML = "";

        question.answers.forEach(a => {
            const li = document.createElement("li");
            li.className = "list-group-item list-group-item-action";
            li.innerText = a.answerText;
            li.onclick = () => submitAnswer(question.questionId, a.answerId);
            list.appendChild(li);
        });
    }

    async function submitAnswer(questionId, answerId) {
        const timeSpent = Math.floor((Date.now() - startTime) / 1000);

        const result = await connection.invoke("SubmitAnswer", {
            gameSessionId,
            questionId,
            answerId,
            timeSpentSeconds: timeSpent
        });

        const box = document.getElementById("result");
        box.classList.remove("d-none");
        box.innerText = result.isCorrect
            ? `✔ Correcto (+${result.pointsEarned})`
            : `✘ Incorrecto`;

        setTimeout(() => {
            box.classList.add("d-none");
            loadNextQuestion();
        }, 1200);
    }

    async function endGame() {
        const gameOver = await connection.invoke("EndGame", gameSessionId);
        alert(`Juego terminado. Puntaje: ${gameOver.totalPoints}`);
    }

    start();
</script>
}
