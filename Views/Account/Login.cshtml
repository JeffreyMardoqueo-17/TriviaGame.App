@model TriviaGame.App.Models.DTOs.User.LoginUserRequestDto

<form asp-action="Login" method="post">
    <input asp-for="Gmail" placeholder="Correo" />
    <span asp-validation-for="Gmail"></span>

    <input asp-for="Password" placeholder="Contraseña" type="password" />
    <span asp-validation-for="Password"></span>

    <button type="submit">Iniciar sesión</button>
</form>

@section Scripts {
<script>
    // 🔹 Si el servidor envía token en TempData (modifica controller para enviar)
    const token = '@TempData["JWT"]';
    const userId = '@TempData["UserId"]';

    if (token && userId) {
        localStorage.setItem("JWT", token);
        localStorage.setItem("UserId", userId);
        console.log("✅ Token guardado en localStorage");
    }
</script>
}
