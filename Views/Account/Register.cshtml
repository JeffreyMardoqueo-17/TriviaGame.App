@model TriviaGame.App.Models.DTOs.User.RegisterUserRequestDto

@{
    ViewData["Title"] = "Registro";
}

<div class="register-container">
    <div class="register-card">
        <h2>Crear cuenta</h2>

        <form asp-action="Register" method="post" onsubmit="return validateForm()">

            <div asp-validation-summary="All" class="text-danger mb-2"></div>

            <div class="form-group">
                <label asp-for="Gmail">Correo electrónico</label>
                <input asp-for="Gmail" class="form-control" placeholder="ejemplo@gmail.com" />
                <span asp-validation-for="Gmail" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Contraseña</label>
                <div class="password-wrapper">
                    <input asp-for="Password" id="password" type="password" class="form-control" />
                    <span class="toggle-password" onclick="togglePassword('password')">Mostrar</span>
                </div>


                <div class="password-rules">
                    <div id="rule-length" class="rule-invalid">• Mínimo 6 caracteres</div>
                    <div id="rule-uppercase" class="rule-invalid">• Al menos una mayúscula</div>
                    <div id="rule-special" class="rule-invalid">• Al menos un carácter especial</div>
                </div>

                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Confirmar contraseña</label>
                <div class="password-wrapper">
                    <input id="confirmPassword" type="password" class="form-control" />
                    <span class="toggle-password" onclick="togglePassword('confirmPassword')">Mostrar</span>
                </div>
                <span id="matchError" class="text-danger"></span>
            </div>

            <button type="submit" id="btnRegister" class="btn-register" disabled>
                Registrarse
            </button>
            </span>¿Ya tienes una cuenta? <a href="/Account/Login">Inicia sesión</a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const passwordInput = document.getElementById("password");
        const confirmInput = document.getElementById("confirmPassword");
        const btnRegister = document.getElementById("btnRegister");

        passwordInput.addEventListener("input", validatePassword);
        confirmInput.addEventListener("input", validatePassword);

        function togglePassword(id) {
            const input = document.getElementById(id);
            input.type = input.type === "password" ? "text" : "password";
        }

        function validatePassword() {
            const password = passwordInput.value;
            const confirm = confirmInput.value;

            const hasLength = password.length >= 6;
            const hasUpper = /[A-Z]/.test(password);
            const hasSpecial = /[!@@#$%^&*(),.?":{}|<>]/.test(password);
            const match = password === confirm && confirm !== "";

            setRule("rule-length", hasLength);
            setRule("rule-uppercase", hasUpper);
            setRule("rule-special", hasSpecial);

            document.getElementById("matchError").textContent =
                confirm && !match ? "Las contraseñas no coinciden" : "";

            btnRegister.disabled = !(hasLength && hasUpper && hasSpecial && match);
        }

        function setRule(id, valid) {
            const el = document.getElementById(id);
            el.className = valid ? "rule-valid" : "rule-invalid";
        }

        function validateForm() {
            return !btnRegister.disabled;
        }
    </script>
}