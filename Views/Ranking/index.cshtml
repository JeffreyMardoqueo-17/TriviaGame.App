@model List<TriviaGame.App.Models.DTOs.Game.CategoryRankingDto>

@{
    ViewData["Title"] = "Tabla de Posiciones";
    var categoryId = ViewBag.CategoryId;
    var top = ViewBag.Top;
}

<h2>Tabla de Posiciones - Categoría @categoryId</h2>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Posición</th>
            <th>Usuario (Gmail)</th>
            <th>Puntos</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            int position = 1;
            foreach (var item in Model)
            {
                <tr>
                    <td>@position</td>
                    <td>@item.Gmail</td>
                    <td>@item.TotalPoints</td>
                </tr>
                position++;
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">No hay datos para mostrar</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count >= top)
{
    <a href="@Url.Action("TablaPosiciones", "Ranking", new { categoryId = categoryId, top = 0 })" class="btn btn-primary">
        Ver Todos
    </a>
}
